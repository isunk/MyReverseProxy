<!DOCTYPE html>
<!--
  MRP Helper
  UTF-8 保存为 mrp.hta 双击运行；拖入浏览器仅显示界面，动作不可用。
  渲染路径全 ASCII：中文用数字实体，圆点用 fromCharCode。
  链接不带 href：HTA NAVIGABLE=no 会把 javascript: 交给默认浏览器，
  手型与颜色由 CSS 提供，@事件统一 preventDefault。
-->
<html lang="zh-CN">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>MRP Helper</title>
<HTA:APPLICATION ID="htaMrp" APPLICATIONNAME="MRP-HELPER" SINGLEINSTANCE="yes" CONTEXTMENU="no" NAVIGABLE="no" />
<script>try { window.resizeTo(880, 860); } catch (ex) {}</script>
<style>
html,body{height:100%;margin:0;font:14px/1.7 "Segoe UI","Microsoft YaHei",sans-serif}
#nav{position:absolute;left:0;top:0;bottom:0;width:140px;border-right:1px solid #eee;padding-top:8px;overflow-y:auto}
#nav a{display:block;padding:8px 16px;border-left:3px solid transparent;color:#333;text-decoration:none}
#nav a.act{border-left-color:#1677ff;background:#f5f8ff;color:#1677ff;font-weight:bold}
#main{position:absolute;left:141px;top:0;right:0;bottom:0}
#top{position:absolute;left:0;right:0;top:0;bottom:320px;padding:6px 14px 0;overflow-y:auto}
fieldset{border:1px solid #e0e0e0;border-radius:4px;margin:0 0 10px;padding:0 12px 8px;min-width:0}
legend{font-size:12px;color:#666;padding:0 6px}
a{color:#1677ff;text-decoration:none;cursor:pointer}
button{background:none;border:0;color:#1677ff;padding:3px 10px;cursor:pointer;font:inherit}
table{width:100%;border-collapse:collapse}
td{border-bottom:1px solid #f5f5f5;padding:8px 4px}
#acts a{margin-right:16px}
#con{position:absolute;left:14px;right:14px;top:330px;bottom:10px;margin:0;padding:0 12px 8px}
pre{position:absolute;left:12px;right:12px;top:24px;bottom:8px;border:1px solid #eee;overflow-y:auto;font:12px/19px Consolas,monospace;margin:0;white-space:pre-wrap;word-break:break-all;box-sizing:border-box}
.dim{color:#999}.ok{color:#52c41a}.warn{color:#e6a23c}.err{color:#ff4d4f}
#mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.3)}
#box{position:fixed;top:30%;left:50%;width:330px;margin-left:-165px;background:#fff;border:1px solid #bbb;padding:12px}
#box p{white-space:pre-line}
#box input{width:100%;margin:8px 0;box-sizing:border-box}
</style>
</head>
<body>

<div id="app">
  <nav id="nav">
    <a v-for="t in tabs" v-class="{act: t.act}" @click="switchTab(t.key)">
      <span>{{ t.label }}</span> <i v-class="toVClass(t.tone)">{{ dot }}</i>
    </a>
  </nav>
  <main id="main">
    <div id="top">
      <fieldset>
        <legend>STATUS &#183; <a v-class="{dim: busy}" @click="refresh">{{ busy ? 'Refreshing...' : 'Refresh' }}</a> &#183; <a class="err" @click="askUninstall">Uninstall</a></legend>
        <table>
          <tr v-for="r in rows">
            <td width="120">{{ r.name }}</td>
            <td><i v-class="toVClass(r.tone)">{{ dot }}</i> {{ r.text }}</td>
            <td align="right"><a v-if="r.act" v-class="{err: r.danger}" @click="rowAct(r)">{{ r.act }}</a></td>
          </tr>
        </table>
      </fieldset>
      <fieldset>
        <legend>TOOLS</legend>
        <p id="acts"><a v-for="a in tools" v-class="{err: a.danger}" @click="runAction(a)">{{ a.name }}</a></p>
      </fieldset>
    </div>
    <fieldset id="con">
      <legend>CONSOLE &#183; <a @click="clearLog">Clear</a></legend>
      <pre id="log"></pre>
    </fieldset>
  </main>
  <div id="mask" v-if="modal">
    <div id="box">
      <b>{{ modal ? modal.title : '' }}</b>
      <p>{{ modal ? modal.text : '' }}</p>
      <input v-if="modal && modal.input" v-model="draft" @keydown.enter="modalOk" />
      <p align="right"><button v-class="{err: modal && modal.danger}" @click="modalOk">{{ modal ? modal.okText : 'OK' }}</button> <button @click="modalNo">Cancel</button></p>
    </div>
  </div>
</div>

<script>
(function(win, doc) {
  'use strict';

  // ---- 常量 ----
  var PORT = '8000',
      HTTP_PORT = '8080',
      CA_HASH = 'd6cd00d8',
      CA_CN = 'DeviceProxy CA',
      CRT = 'ca.crt',
      KEY = 'ca.key',
      DEV_CFG = 'config.yaml',
      DEV_BIN = 'mrp-linux-arm64',
      MRP_EXE = 'mrp-windows-amd64.exe';

  var CA_CERT = [
    '-----BEGIN CERTIFICATE-----',
    'MIIBmDCCAT2gAwIBAgIUVfZslYEayBAiv6+V9lA5ktPf9jYwCgYIKoZIzj0EAwIw',
    'GTEXMBUGA1UEAwwORGV2aWNlUHJveHkgQ0EwHhcNMjYwOTI5MDMwNTQzWhcNMzYw',
    'OTI2MDMwNTQzWjAZMRcwFQYDVQQDDA5EZXZpY2VQcm94eSBDQTBZMBMGByqGSM49',
    'AgEGCCqGSM49AwEHA0IABCh7WdaFBMOCXNjbRjaICJfAGQ2uCcBjKE+mDiqxCzxL',
    '9LbtiJm7iKZDg7FUvb6vPGdRSHhYUIwlAIDbgBTTQJmjYzBhMB0GA1UdDgQWBBTo',
    'tHWQTTk1+kp3Gn/omx7RbgFd6TAfBgNVHSMEGDAWgBTotHWQTTk1+kp3Gn/omx7R',
    'bgFd6TAPBgNVHRMBAf8EBTADAQH/MA4GA1UdDwEB/wQEAwIChDAKBggqhkjOPQQD',
    'AgNJADBGAiEAsrLEFOvjAceXTc2WfnFCAoU0sGFVWrbOy3mj0A0r3CYCIQDYLtbX',
    'It95OQr70jbFEwPw4mcqqHVaq59Vg35lGsF50Q==',
    '-----END CERTIFICATE-----'
  ];
  var CA_KEY = [
    '-----BEGIN PRIVATE KEY-----',
    'MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgkFv91z9F6RVPe5cI',
    'cKsnH6OQt66aQXn3bB+mQqJo+j2hRANCAAQoe1nWhQTDglzY20Y2iAiXwBkNrgnA',
    'YyhPpg4qsQs8S/S27YiZu4imQ4OxVL2+rzxnUUh4WFCMJQCA24AU00CZ',
    '-----END PRIVATE KEY-----'
  ];

  // ---- 日志 ----
  var logBox = null;
  function pad2(n) {
    n = String(n);
    return n.length < 2 ? '0' + n : n;
  }

  function logClear() {
    if (logBox) logBox.innerHTML = '';
  }

  // ---- 宿主接口 ----
  // ActiveX 实例只创建一次并复用；创建失败说明运行在浏览器，后续操作静默失效
  var shell = null, fso = null;
  try {
    shell = new win.ActiveXObject('WScript.Shell');
    fso = new win.ActiveXObject('Scripting.FileSystemObject');
  } catch (ex) {
    // host 尚未就绪，错误提示延后到脚本求值完成后输出
    setTimeout(function() {
      host.log('host=browser - no shell available, actions will fail.', 'err');
    }, 0);
  }

  var host = {
    workdir: (function() {
      var s = unescape(location.href).replace(/\+/g, ' ').replace(/^file:\/\/\//i, '').replace(/\//g, '\\');
      return s.substring(0, s.lastIndexOf('\\') + 1);
    })(),
    log: function(text, lv) {
      var box = logBox || (logBox = doc.getElementById('log'));
      if (!box) return;
      var d = doc.createElement('div');
      if (lv) d.className = lv;
      var t = new Date();
      d.innerHTML = '<i class="dim">[' + pad2(t.getHours()) + ':' + pad2(t.getMinutes()) + ':' + pad2(t.getSeconds()) + ']</i> ' +
        String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      box.appendChild(d);
      while (box.children.length > 300) box.removeChild(box.firstChild);
      box.scrollTop = box.scrollHeight;
    },
    run: function(cmd, show, wait) {
      if (cmd.indexOf('timeout ') !== 0) host.log('> ' + cmd, 'dim');
      try { return shell.Run('%comspec% /c "' + cmd + '"', show ? 1 : 0, wait !== false); }
      catch (ex) { return 1; }
    },
    exec: function(cmd) {
      var tmp = host.workdir + '.hta.output';
      try { shell.Run('%comspec% /c (' + cmd + ') > "' + tmp + '"', 0, true); }
      catch (ex) { return ''; }
      var out = host.file.read('.hta.output');
      host.file.remove(['.hta.output']);
      return out;
    },
    file: {
      exists: function(name) {
        try { return fso.FileExists(host.workdir + name); }
        catch (ex) { return false; }
      },
      read: function(name) {
        var out = '';
        try {
          var f = fso.OpenTextFile(host.workdir + name, 1, false, 0);
          if (!f.AtEndOfStream) out = f.ReadAll();
          f.Close();
        } catch (ex) {}
        return out;
      },
      write: function(name, lines) {
        try {
          var f = fso.CreateTextFile(host.workdir + name, true, false);
          for (var i = 0; i < lines.length; i++) f.WriteLine(lines[i]);
          f.Close();
        } catch (ex) {}
      },
      remove: function(names) {
        try {
          for (var i = 0; i < names.length; i++) {
            if (fso.FileExists(host.workdir + names[i])) fso.DeleteFile(host.workdir + names[i], true);
          }
        } catch (ex) {}
      }
    }
  };

  // ---- 输入持久化 ----
  var inputCache = {}, INPUT_FILE = '.hta.input';

  (function() {
    var lines = host.file.read(INPUT_FILE).split('\r\n');
    for (var i = 0; i < lines.length; i++) {
      var idx = lines[i].indexOf('\t');
      if (idx > 0) inputCache[lines[i].substring(0, idx)] = lines[i].substring(idx + 1);
    }
  })();

  function flushInput() {
    var lines = [];
    for (var k in inputCache) {
      if (Object.prototype.hasOwnProperty.call(inputCache, k)) lines.push(k + '\t' + inputCache[k]);
    }
    host.file.write(INPUT_FILE, lines);
  }

  function loadInput(key) {
    return inputCache[key] || '';
  }

  var flushTimer = null;
  function scheduleFlush() {
    if (flushTimer) clearTimeout(flushTimer);
    flushTimer = setTimeout(flushInput, 500);
  }
  function saveInput(key, value) {
    inputCache[key] = value;
    scheduleFlush();
  }

  // ---- MyVue 响应式引擎 ----
  // 核心：defineProperty 劫持 + 依赖追踪 + 模板编译
  function MyVue(options) {
    var self = this,
        _ecache = {},
        _collect = null,
        _errSeen = {},
        _depth = 0;

    this.$el = doc.querySelector(options.el || '#app');
    this.$data = typeof options.data === 'function' ? options.data() : (options.data || {});
    this._deps = {};
    this._ctx = {};

    function each(obj, fn) {
      for (var k in obj) if (Object.prototype.hasOwnProperty.call(obj, k)) fn(obj[k], k);
    }

    function on(el, ev, fn) {
      if (el.addEventListener) el.addEventListener(ev, fn, false);
      else if (el.attachEvent) el.attachEvent('on' + ev, fn);
    }

    function toggleClass(el, c, add) {
      var cn = el.className.split(/\s+/), i = cn.indexOf(c);
      if (add && i < 0) cn.push(c);
      if (!add && i >= 0) cn.splice(i, 1);
      el.className = cn.join(' ').replace(/^\s+|\s+$/g, '');
    }

    function report(msg) {
      if (_errSeen[msg]) return;
      _errSeen[msg] = 1;
      if (options.onerror) options.onerror('[kernel] ' + msg);
    }

    function getPath(key) {
      var ks = key.split('.'), o = self.$data, i;
      for (i = 0; i < ks.length && o != null; i++) o = o[ks[i]];
      return o;
    }

    function setPath(key, value) {
      var ks = key.split('.'), o = self.$data, i;
      for (i = 0; i < ks.length - 1; i++) {
        o = o[ks[i]];
        if (o == null) return;
      }
      o[ks[i]] = value;
    }

    function addDep(path, fn) {
      var a = self._deps[path] || (self._deps[path] = []);
      if (a.indexOf(fn) < 0) a.push(fn);
    }

    function delDep(path, fn) {
      var a = self._deps[path], i;
      if (a && (i = a.indexOf(fn)) >= 0) a.splice(i, 1);
    }

    function notify(path) {
      var queues = [];
      each(self._deps, function(subs, key) {
        if (path === key || path.indexOf(key + '.') === 0) queues.push(subs.slice());
      });
      for (var i = 0; i < queues.length; i++) {
        for (var j = 0; j < queues[i].length; j++) {
          if (++_depth > 200) {
            _depth--;
            report('update cascade exceeded 200 levels at path "' + path + '"');
            return;
          }
          try { queues[i][j](); }
          catch (ex) { report('update failed: ' + (ex && ex.message ? ex.message : ex)); }
          _depth--;
        }
      }
    }

    function defineReactive(obj, key, val, path) {
      if (val && typeof val === 'object') walk(val, path);
      Object.defineProperty(obj, key, {
        get: function() {
          if (_collect && _collect.indexOf(path) < 0) _collect.push(path);
          return val;
        },
        set: function(nv) {
          if (nv === val) return;
          val = nv;
          notify(path);
        }
      });
    }

    function walk(obj, base) {
      each(obj, function(v, k) {
        if (k !== 'length') defineReactive(obj, k, v, base ? base + '.' + k : k);
      });
    }

    function evalExpr(expr, $s) {
      var fn = _ecache[expr] || (_ecache[expr] = new Function('$c', '$s', 'with($c){with($s||{}){return (' + expr + ');}}'));
      try { return fn.call(self._ctx, self._ctx, $s); }
      catch (ex) { report('expr "' + expr + '": ' + (ex && ex.message ? ex.message : ex)); return undefined; }
    }

    function track(run) {
      var own = {};
      function fire() {
        var prev = _collect, paths, i, k;
        _collect = [];
        try { run(); }
        finally { paths = _collect; _collect = prev; }
        var fresh = {};
        for (i = 0; i < paths.length; i++) {
          fresh[paths[i]] = 1;
          if (!own[paths[i]]) {
            own[paths[i]] = 1;
            addDep(paths[i], fire);
          }
        }
        for (k in own) if (!fresh[k]) { delDep(k, fire); delete own[k]; }
      }
      fire();
      return fire;
    }

    function computed(key, fn) {
      var last;
      track(function() {
        var nv = fn.call(self._ctx);
        if (nv !== last) { last = nv; self.$data[key] = nv; }
      });
    }

    function bindText(node, $s) {
      var src = node.nodeValue, re = /\{\{\s*([^}]+?)\s*\}\}/g;
      if (!re.test(src)) return;
      re.lastIndex = 0;
      var frag = doc.createDocumentFragment(), binds = [], last = 0, m, tn;
      while ((m = re.exec(src))) {
        if (m.index > last) frag.appendChild(doc.createTextNode(src.slice(last, m.index)));
        tn = doc.createTextNode('');
        frag.appendChild(tn);
        binds.push({ tn: tn, expr: m[1] });
        last = m.index + m[0].length;
      }
      if (last < src.length) frag.appendChild(doc.createTextNode(src.slice(last)));
      node.parentNode.replaceChild(frag, node);
      for (var i = 0; i < binds.length; i++) bindSeg(binds[i], $s);
    }

    function bindSeg(seg, $s) {
      track(function() {
        var v = evalExpr(seg.expr, $s), s2 = v == null ? '' : String(v);
        if (seg.tn.nodeValue !== s2) seg.tn.nodeValue = s2;
      });
    }

    function bindEvent(el, spec, $s) {
      var dot = spec.name.substring(1).split('.'), ev = dot[0], kc = dot[1] === 'enter' ? 13 : 0;
      var m2 = spec.value.replace(/^\s+|\s+$/g, '').match(/^([\w$]+)\s*(?:\((.*)\))?$/);
      var argFn = (m2 && m2[2]) ? m2[2] : null;
      on(el, ev, function(e) {
        e = e || win.event;
        if (kc && (e.keyCode || e.which) !== kc) return;
        if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
        if (!m2) { report('bad handler: ' + spec.value); return; }
        var fn2 = self._ctx[m2[1]];
        if (!fn2) { report('handler not found: ' + spec.value); return; }
        try { fn2(argFn ? evalExpr(argFn, $s) : e); }
        catch (ex) { report(spec.value + ' -> ' + (ex && ex.message ? ex.message : ex)); }
      });
    }

    function setupFor(el, expr) {
      var m = expr.match(/^\s*([\w$]+)\s+in\s+(.+?)\s*$/), parent = el.parentNode;
      if (!m || !parent) return;
      var name = m[1], listExpr = m[2];
      var anchor = doc.createComment('v-for');
      parent.insertBefore(anchor, el);
      parent.removeChild(el);
      var tpl = el.cloneNode(true);
      tpl.removeAttribute('v-for');
      track(function() {
        try {
          var list = evalExpr(listExpr) || [], n, i;
          while ((n = anchor.nextSibling) && n._vfor) parent.removeChild(n);
          var after = anchor.nextSibling;
          for (i = 0; i < list.length; i++) {
            var node = tpl.cloneNode(true);
            node._vfor = 1;
            parent.insertBefore(node, after);
            var $s = {};
            $s[name] = list[i];
            compile(node, $s);
          }
        } catch (ex) { report('v-for "' + listExpr + '": ' + (ex && ex.message ? ex.message : ex)); }
      });
    }

    function compile(el, $s) {
      if (!el || !el.getAttribute) return;
      var vfor = el.getAttribute('v-for');
      if (vfor) { setupFor(el, vfor); return; }
      var nodes = el.childNodes, arr = [], i, n;
      for (i = 0; i < nodes.length; i++) arr.push(nodes[i]);
      for (i = 0; i < arr.length; i++) {
        n = arr[i];
        if (n.nodeType === 3) bindText(n, $s);
        else compile(n, $s);
      }
      var modelKey = el.getAttribute('v-model');
      if (modelKey) {
        var h = function() {
          setPath(modelKey, el.value);
        };
        on(el, 'input', h); on(el, 'change', h);
        track(function() {
          var v = getPath(modelKey), s2 = v == null ? '' : String(v);
          if (el.value !== s2) el.value = s2;
        });
      }
      var ifExpr = el.getAttribute('v-if');
      if (ifExpr) {
        var ph = doc.createComment('v-if'), shown = true;
        track(function() {
          var v = evalExpr(ifExpr, $s);
          if (v && !shown && ph.parentNode) { ph.parentNode.replaceChild(el, ph); shown = true; }
          else if (!v && shown && el.parentNode) { el.parentNode.replaceChild(ph, el); shown = false; }
        });
      }
      var clsExpr = el.getAttribute('v-class');
      if (clsExpr) {
        track(function() {
          var map = evalExpr(clsExpr, $s);
          if (map) for (var c in map) if (Object.prototype.hasOwnProperty.call(map, c)) toggleClass(el, c, !!map[c]);
        });
      }
      var atts = el.attributes;
      for (i = 0; i < atts.length; i++) if (atts[i].name.charAt(0) === '@') bindEvent(el, atts[i], $s);
    }

    walk(this.$data, '');
    each(this.$data, function(v, k) {
      Object.defineProperty(self._ctx, k, {
        get: function() {
          return self.$data[k];
        },
        set: function(nv) {
          self.$data[k] = nv;
        }
      });
    });
    each(options.methods || {}, function(fn, k) { self._ctx[k] = fn.bind(self._ctx); });
    if (options.computed) each(options.computed, function(fn, k) { computed(k, fn); });
    compile(this.$el, null);
    if (options.mounted) options.mounted.call(this._ctx);
  }

  // ---- CA 证书管理 ----
  if (!host.file.exists(CRT)) host.file.write(CRT, CA_CERT);
  if (!host.file.exists(KEY)) host.file.write(KEY, CA_KEY);

  // ---- 模块定义 ----
  // states: get(data) 实时探测返回 [状态标识, 文案, 颜色]；state 按标识映射按钮 [文案, 事件, 危险]；tools 固定工具；health 页签圆点；uninstall 顶部卸载
  var modules = [
    {
      name: 'Windows',
      data: { filesOK: true, miss: [], cert: 'NONE', run: false },
      health: function(data) {
        return data.filesOK && data.cert !== 'NONE' && data.run ? 'ok' : 'warn';
      },
      states: [
        {
          name: 'Files',
          get: function(data) {
            var want = [MRP_EXE, CRT, KEY], i;
            data.miss = [];
            for (i = 0; i < want.length; i++) if (!host.file.exists(want[i])) data.miss.push(want[i]);
            data.filesOK = data.miss.length === 0;
            return [data.filesOK ? 'TRUE' : 'FALSE', data.filesOK ? 'OK' : 'Missing: ' + data.miss.join(', '), data.filesOK ? 'ok' : 'err'];
          },
          state: {
            FALSE: ['Check files', function(data, vm) {
              var want = [MRP_EXE, CRT, KEY], lacking = [], i;
              for (i = 0; i < want.length; i++) if (!host.file.exists(want[i])) lacking.push(want[i]);
              if (lacking.length === 0) { host.log('Files ready.', 'ok'); return; }
              host.log('Missing ' + lacking.join(', ') + ' in ' + host.workdir + ' - download from GitHub Releases.', 'err');
            }],
          },
        },
        {
          name: 'CA certificate',
          get: function(data) {
            data.cert = 'NONE';
            if (host.file.exists(CRT)) {
              var dump = host.exec('certutil -dump "' + host.workdir + CRT + '"').toLowerCase();
              var found = dump.match(/cn=([^,\r\n]+)/);
              if (found) {
                var cn = found[1];
                if (host.exec('certutil -store Root 2>nul').toLowerCase().indexOf('cn=' + cn) >= 0) data.cert = 'MACHINE';
                else if (host.exec('certutil -user -store Root 2>nul').toLowerCase().indexOf('cn=' + cn) >= 0) data.cert = 'USER';
              }
            }
            var ok = data.cert !== 'NONE';
            return [ok ? 'TRUE' : 'FALSE', ok ? 'Imported [' + data.cert + ']' : 'Not imported', ok ? 'ok' : 'warn'];
          },
          state: {
            TRUE: ['Remove', function(data, vm) {
              host.run('powershell -NoProfile -Command "Get-ChildItem Cert:\\CurrentUser\\Root | Where-Object {$_.Subject -eq \'CN=' + CA_CN + '\' } | Remove-Item -Force" >nul 2>&1');
              host.log('CA removed.', 'ok');
            }, true],
            FALSE: ['Import CA', function(data, vm) {
              if (data.cert !== 'NONE') { host.log('Already imported [' + data.cert + '].', 'ok'); return; }
              var code = host.run('certutil -user -addstore Root "' + host.workdir + CRT + '"');
              if (code === 0) host.log('CA imported into the user Root store.', 'ok');
              else host.log('CA import failed.', 'err');
            }],
          },
        },
        {
          name: 'MRP Process',
          get: function(data) {
            data.run = host.exec('tasklist /fi "imagename eq ' + MRP_EXE + '" /nh 2>nul').toLowerCase().indexOf(MRP_EXE.toLowerCase()) >= 0;
            return [data.run ? 'TRUE' : 'FALSE', data.run ? 'Running' : 'Stopped', data.run ? 'ok' : 'warn'];
          },
          state: {
            TRUE: ['Stop', function(data, vm) {
              if (host.exec('tasklist /fi "imagename eq ' + MRP_EXE + '" /nh 2>nul').toLowerCase().indexOf(MRP_EXE.toLowerCase()) >= 0) host.run('taskkill /im "' + MRP_EXE + '" /f');
              host.log('mrp stopped.', 'ok');
            }],
            FALSE: ['Start', function(data, vm) {
              if (host.exec('tasklist /fi "imagename eq ' + MRP_EXE + '" /nh 2>nul').toLowerCase().indexOf(MRP_EXE.toLowerCase()) >= 0) { host.log('mrp already running.', 'ok'); return; }
              host.run('start "mrp" /D "' + host.workdir + '" "' + host.workdir + MRP_EXE + '"', true);
              host.log('mrp started in a new window.', 'ok');
            }],
          },
        },
        {
          name: 'Proxy',
          get: function(data) {
            var on = host.exec('netsh winhttp show proxy 2>nul').indexOf('127.0.0.1:' + PORT) >= 0;
            return [on ? 'TRUE' : 'FALSE', on ? 'Configured (127.0.0.1:' + PORT + ')' : 'Not set', on ? 'ok' : 'warn'];
          },
          state: {
            TRUE: ['Clear', function(data, vm) {
              var cmd = 'netsh winhttp reset proxy';
              if (host.exec('net session >nul 2>&1 && echo OK') === '') {
                var ps = 'powershell -NoProfile -Command "Start-Process -FilePath cmd.exe -Verb RunAs -Wait -ArgumentList \'/c ' + cmd.replace(/'/g, "''") + "'\"";
                host.log('> ' + cmd + ' [runas]', 'dim');
                host.run(ps, 0, true);
              } else host.run(cmd);
              var ok = host.exec('netsh winhttp show proxy 2>nul').indexOf('127.0.0.1:' + PORT) < 0;
              host.log(ok ? 'System proxy cleared.' : 'Proxy not cleared.', ok ? 'ok' : 'warn');
            }],
            FALSE: ['Set', function(data, vm) {
              var cmd = 'netsh winhttp set proxy 127.0.0.1:' + PORT;
              if (host.exec('net session >nul 2>&1 && echo OK') === '') {
                var ps = 'powershell -NoProfile -Command "Start-Process -FilePath cmd.exe -Verb RunAs -Wait -ArgumentList \'/c ' + cmd.replace(/'/g, "''") + "'\"";
                host.log('> ' + cmd + ' [runas]', 'dim');
                host.run(ps, 0, true);
              } else host.run(cmd);
              var ok = host.exec('netsh winhttp show proxy 2>nul').indexOf('127.0.0.1:' + PORT) >= 0;
              host.log(ok ? 'System proxy set to 127.0.0.1:' + PORT + '.' : 'Proxy not applied.', ok ? 'ok' : 'warn');
            }],
          },
        },
      ],
      tools: [
        {
          name: 'Static HTTP :' + HTTP_PORT,
          run: function(data, vm) {
            vm.prompt('Static HTTP server', 'Directory to serve', host.workdir, function(dir) {
              dir = String(dir == null ? '' : dir).replace(/^\s+|\s+$/g, '');
              if (dir === '') return;
              host.run('cmd /k python -m http.server ' + HTTP_PORT + ' --directory "' + dir + '"', 1, false);
              host.log('Static server serving ' + dir + ' at http://127.0.0.1:' + HTTP_PORT + '.', 'ok');
            });
          },
        },
      ],
      uninstall: function(data) {
        var cmd = 'netsh winhttp reset proxy';
        if (host.exec('net session >nul 2>&1 && echo OK') === '') {
          var ps = 'powershell -NoProfile -Command "Start-Process -FilePath cmd.exe -Verb RunAs -Wait -ArgumentList \'/c ' + cmd.replace(/'/g, "''") + "'\"";
          host.log('> ' + cmd + ' [runas]', 'dim');
          host.run(ps, 0, true);
        } else host.run(cmd);
        if (host.exec('netsh winhttp show proxy 2>nul').indexOf('127.0.0.1:' + PORT) >= 0) host.log('System proxy may still be set - clear it manually.', 'warn');
        if (host.exec('tasklist /fi "imagename eq ' + MRP_EXE + '" /nh 2>nul').toLowerCase().indexOf(MRP_EXE.toLowerCase()) >= 0) host.run('taskkill /im "' + MRP_EXE + '" /f');
        host.run('powershell -NoProfile -Command "Get-ChildItem Cert:\\CurrentUser\\Root | Where-Object {$_.Subject -eq \'CN=' + CA_CN + '\' } | Remove-Item -Force" >nul 2>&1');
        host.file.remove([MRP_EXE, CRT, KEY]);
        host.log('Windows module uninstalled.', 'ok');
      },
    },
    {
      name: 'Android',
      data: {
        devDir: '/data/local/mrp',
        certPath: '/system/etc/security/cacerts/' + CA_HASH + '.0',
        ready: false, desc: '', bin: false, cert: false, run: false,
      },
      health: function(data) {
        return !data.ready ? 'dim' : (data.cert && data.bin && data.run ? 'ok' : (data.cert || data.bin ? 'warn' : 'err'));
      },
      states: [
        {
          name: 'Device',
          get: function(data) {
            data.ready = false; data.desc = '';
            if (host.exec('where adb >nul 2>&1 && echo OK') === '') {
              data.desc = 'Not installed';
            } else {
              var lines = host.exec('adb devices 2>nul').split('\n'), i;
              for (i = 1; i < lines.length; i++) {
                var cols = lines[i].replace(/\r/g, '').split(/\s+/);
                if (cols.length >= 2 && cols[1] === 'device') { data.ready = true; data.desc = cols[0]; break; }
              }
              if (!data.ready) data.desc = 'No device connected';
            }
            return [data.ready ? 'TRUE' : 'FALSE', data.desc || 'Not probed.', data.ready ? 'ok' : 'dim'];
          },
          state: {
            TRUE: ['Sync config', function(data, vm) {
              if (!host.file.exists(DEV_CFG)) { host.log(DEV_CFG + ' not found next to this script.', 'err'); return; }
              host.run('adb shell mkdir -p ' + data.devDir);
              if (host.run('adb push "' + host.workdir + DEV_CFG + '" ' + data.devDir) !== 0) { host.log('Config sync failed - check the device connection.', 'err'); return; }
              host.log(DEV_CFG + ' synced - mrp hot reloads it automatically.', 'ok');
            }],
          },
        },
        {
          name: 'Files',
          get: function(data) {
            if (!data.ready) return null;
            data.bin = host.exec('adb shell "test -f ' + data.devDir + '/' + DEV_BIN + ' && echo Y" 2>nul') !== '';
            return [data.bin ? 'TRUE' : 'FALSE', data.bin ? 'Installed' : 'Not installed', data.bin ? 'ok' : 'warn'];
          },
          state: {
            FALSE: ['Install files', function(data, vm) {
              host.run('adb shell mkdir -p ' + data.devDir);
              var rc = host.run('adb push "' + host.workdir + DEV_BIN + '" ' + data.devDir);
              if (rc !== 0) { host.log('Binary push failed rc=' + rc + ' - download ' + DEV_BIN + ' into ' + host.workdir + ' from GitHub Releases.', 'err'); return; }
              if (host.file.exists(DEV_CFG)) host.run('adb push "' + host.workdir + DEV_CFG + '" ' + data.devDir);
              var bad = [];
              if (host.run('adb push "' + host.workdir + CRT + '" ' + data.devDir) !== 0) bad.push(CRT);
              if (host.run('adb push "' + host.workdir + KEY + '" ' + data.devDir) !== 0) bad.push(KEY);
              host.run('adb shell chmod +x ' + data.devDir + '/' + DEV_BIN);
              host.log(bad.length ? 'Binary installed, CA push failed for ' + bad.join(', ') + '.' : 'Device files installed.', bad.length ? 'warn' : 'ok');
            }],
          },
        },
        {
          name: 'CA certificate',
          get: function(data) {
            if (!data.ready) return null;
            data.cert = host.exec('adb shell "test -f ' + data.certPath + ' && echo Y" 2>nul') !== '';
            return [data.cert ? 'TRUE' : 'FALSE', data.cert ? 'Installed' : 'Not installed', data.cert ? 'ok' : 'warn'];
          },
          state: {
            TRUE: ['Remove', function(data, vm) {
              host.run('adb root');
              host.run('timeout /t 3 >nul');
              host.run('adb wait-for-device');
              host.run('adb remount');
              host.run('adb shell rm -f ' + data.certPath);
              host.log('CA removed.', 'ok');
            }, true],
            FALSE: ['Install CA', function(data, vm) {
              host.run('adb root');
              host.run('timeout /t 3 >nul');
              host.run('adb wait-for-device');
              host.run('adb remount');
              host.run('adb push "' + host.workdir + CRT + '" ' + data.certPath);
              host.run('adb shell chmod 644 ' + data.certPath);
              if (host.exec('adb shell "test -f ' + data.certPath + ' && echo Y" 2>nul') !== '') { host.log('CA installed.', 'ok'); return; }
              host.log('CA install may have failed - ensure the device is rooted or in developer mode.', 'warn');
            }],
          },
        },
        {
          name: 'MRP Process',
          get: function(data) {
            if (!data.ready) return null;
            // NO_BIN 不在 state 中，未安装二进制时不显示按钮
            if (!data.bin) return ['NO_BIN', 'Not installed', 'err'];
            data.run = host.exec('adb shell pidof ' + DEV_BIN + ' 2>nul') !== '';
            return [data.run ? 'TRUE' : 'FALSE', data.run ? 'Running' : 'Stopped', data.run ? 'ok' : 'warn'];
          },
          state: {
            TRUE: ['Stop', function(data, vm) {
              host.run('adb shell "kill -9 $(pidof ' + DEV_BIN + ')" >nul 2>&1');
              host.log('mrp stopped.', 'ok');
            }],
            FALSE: ['Start', function(data, vm) {
              if (host.exec('adb shell pidof ' + DEV_BIN + ' 2>nul') !== '') { host.log('mrp already running on the device.', 'ok'); return; }
              // nohup 后台运行：adb 会话断开（拔 USB）不终止 mrp，输出落设备侧日志
              host.run('adb shell "cd ' + data.devDir + '; nohup ./' + DEV_BIN + ' >mrp.log 2>&1 &"');
              var up = false, i;
              for (i = 0; i < 5; i++) { host.run('timeout /t 1 >nul'); if (host.exec('adb shell pidof ' + DEV_BIN + ' 2>nul') !== '') { up = true; break; } }
              host.log(up ? 'mrp started in the background on the device - output in ' + data.devDir + '/mrp.log.' : 'mrp did not start within 5 seconds.', up ? 'ok' : 'err');
            }],
          },
        },
        {
          name: 'Proxy',
          get: function(data) {
            if (!data.ready) return null;
            var on = host.exec('adb shell settings get global http_proxy 2>nul').indexOf('127.0.0.1:' + PORT) === 0;
            return [on ? 'TRUE' : 'FALSE', on ? 'Configured (127.0.0.1:' + PORT + ')' : 'Not set', on ? 'ok' : 'warn'];
          },
          state: {
            TRUE: ['Clear', function(data, vm) {
              host.run('adb shell settings put global http_proxy :0');
              host.log('Device global proxy cleared.', 'ok');
            }],
            FALSE: ['Set', function(data, vm) {
              host.run('adb shell settings put global http_proxy 127.0.0.1:' + PORT);
              host.log('Device global proxy set to 127.0.0.1:' + PORT + '.', 'ok');
            }],
          },
        },
      ],
      tools: [
        {
          name: 'Port forward :' + PORT,
          run: function(data, vm) {
            host.run('adb forward tcp:' + PORT + ' tcp:' + PORT);
            host.log('Forward port :' + PORT + ' active - PC proxy target 127.0.0.1:' + PORT + '.', 'ok');
          },
        },
        {
          name: 'Port reverse :' + HTTP_PORT,
          run: function(data, vm) {
            host.run('adb reverse tcp:' + HTTP_PORT + ' tcp:' + HTTP_PORT);
            host.log('Reverse port :' + HTTP_PORT + ' active.', 'ok');
          },
        },
        {
          name: 'Open browser',
          run: function(data, vm) {
            vm.prompt('Open browser', 'URL to open on the device', 'http://127.0.0.1:' + HTTP_PORT + '/', function(url) {
              url = String(url == null ? '' : url).replace(/^\s+|\s+$/g, '');
              if (url === '') return;
              host.run('adb shell am start -a android.intent.action.VIEW -d "' + url + '"', false);
            });
          },
        },
        {
          name: 'DevTools',
          run: function(data, vm) {
            var probe = 'adb shell \'cat /proc/net/unix | grep devtools | head -n 1 | cut -d @ -f2\'';
            var rc = host.run('powershell -Command "adb forward tcp:9222 localabstract:$(' + probe + ')"', 0, true);
            host.log(rc === 0 ? 'DevTools port forwarding active.' : 'DevTools port forwarding failed rc=' + rc + '.', rc === 0 ? 'ok' : 'err');
          },
        },
        {
          name: 'Tail log',
          run: function(data, vm) {
            if (host.exec('adb shell "test -f ' + data.devDir + '/mrp.log && echo Y" 2>nul') === '') { host.log('mrp.log not found on the device.', 'warn'); return; }
            host.run('cmd /k adb shell "tail -n 200 -f ' + data.devDir + '/mrp.log"', 1, false);
            host.log('mrp.log tailing in a new window.', 'ok');
          },
        },
      ],
      uninstall: function(data) {
        host.run('adb shell "kill -9 $(pidof ' + DEV_BIN + ')" >nul 2>&1');
        host.run('adb shell settings put global http_proxy :0');
        host.run('adb root');
        host.run('timeout /t 3 >nul');
        host.run('adb wait-for-device');
        host.run('adb remount');
        host.run('adb shell rm -f ' + data.certPath);
        host.run('adb shell rm -rf ' + data.devDir);
        host.log('Android uninstalled.', 'ok');
      },
    },
    {
      name: 'HarmonyOS',
      data: {
        devDir: '/data/local/mrp',
        certPath: '/etc/security/certificates/' + CA_HASH + '.0',
        ready: false, desc: '', bin: false, cert: false, run: false, proxy: false,
      },
      health: function(data) {
        return !data.ready ? 'dim' : (data.cert && data.bin && data.run ? 'ok' : (data.cert || data.bin ? 'warn' : 'err'));
      },
      states: [
        {
          name: 'Device',
          get: function(data) {
            data.ready = false; data.desc = '';
            if (host.exec('where hdc >nul 2>&1 && echo OK') === '') {
              data.desc = 'Not installed';
            } else {
              var lines = host.exec('hdc list targets 2>nul').split('\n'), target = '', i;
              for (i = 0; i < lines.length; i++) {
                var t = lines[i].replace(/\s+/g, '');
                if (t !== '') target = t;
              }
              var head = target.substring(0, 7);
              if (target === '' || head === '[Empty]' || head === 'Connect') data.desc = 'No device connected';
              else { data.ready = true; data.desc = target; }
            }
            return [data.ready ? 'TRUE' : 'FALSE', data.desc || 'Not probed.', data.ready ? 'ok' : 'dim'];
          },
          state: {
            TRUE: ['Sync config', function(data, vm) {
              if (!host.file.exists(DEV_CFG)) { host.log(DEV_CFG + ' not found next to this script.', 'err'); return; }
              host.run('hdc shell mkdir -p ' + data.devDir);
              if (host.run('hdc file send "' + host.workdir + DEV_CFG + '" ' + data.devDir) !== 0) { host.log('Config sync failed - check the device connection.', 'err'); return; }
              host.log(DEV_CFG + ' synced - mrp hot reloads it automatically.', 'ok');
            }],
          },
        },
        {
          name: 'Files',
          get: function(data) {
            if (!data.ready) return null;
            data.bin = host.exec('hdc shell "test -f ' + data.devDir + '/' + DEV_BIN + ' && echo Y" 2>nul') !== '';
            return [data.bin ? 'TRUE' : 'FALSE', data.bin ? 'Installed' : 'Not installed', data.bin ? 'ok' : 'warn'];
          },
          state: {
            FALSE: ['Install files', function(data, vm) {
              host.run('hdc shell mkdir -p ' + data.devDir);
              var rc = host.run('hdc file send "' + host.workdir + DEV_BIN + '" ' + data.devDir);
              if (rc !== 0) { host.log('Binary push failed rc=' + rc + ' - download ' + DEV_BIN + ' into ' + host.workdir + ' from GitHub Releases.', 'err'); return; }
              if (host.file.exists(DEV_CFG)) host.run('hdc file send "' + host.workdir + DEV_CFG + '" ' + data.devDir);
              var bad = [];
              if (host.run('hdc file send "' + host.workdir + CRT + '" ' + data.devDir) !== 0) bad.push(CRT);
              if (host.run('hdc file send "' + host.workdir + KEY + '" ' + data.devDir) !== 0) bad.push(KEY);
              host.run('hdc shell chmod +x ' + data.devDir + '/' + DEV_BIN);
              host.log(bad.length ? 'Binary installed, CA push failed for ' + bad.join(', ') + '.' : 'Device files installed.', bad.length ? 'warn' : 'ok');
            }],
          },
        },
        {
          name: 'CA certificate',
          get: function(data) {
            if (!data.ready) return null;
            data.cert = host.exec('hdc shell "test -f ' + data.certPath + ' && echo Y" 2>nul') !== '';
            return [data.cert ? 'TRUE' : 'FALSE', data.cert ? 'Installed' : 'Not installed', data.cert ? 'ok' : 'warn'];
          },
          state: {
            TRUE: ['Remove', function(data, vm) {
              host.run('hdc shell rm -f ' + data.certPath);
              host.log('CA removed.', 'ok');
            }, true],
            FALSE: ['Install CA', function(data, vm) {
              var tmp = '%TEMP%\\' + CA_HASH + '.0';
              host.run('copy /y "' + host.workdir + CRT + '" "' + tmp + '" >nul');
              host.run('hdc file send "' + tmp + '" /etc/security/certificates');
              if (host.exec('hdc shell "test -f ' + data.certPath + ' && echo Y" 2>nul') !== '') { host.log('CA installed.', 'ok'); return; }
              host.log('CA install may have failed - ensure the device is rooted or in developer mode.', 'warn');
            }],
          },
        },
        {
          name: 'MRP Process',
          get: function(data) {
            if (!data.ready) return null;
            // NO_BIN 不在 state 中，未安装二进制时不显示按钮
            if (!data.bin) return ['NO_BIN', 'Not installed', 'err'];
            data.run = host.exec('hdc shell pidof ' + DEV_BIN + ' 2>nul') !== '';
            return [data.run ? 'TRUE' : 'FALSE', data.run ? 'Running' : 'Stopped', data.run ? 'ok' : 'warn'];
          },
          state: {
            TRUE: ['Stop', function(data, vm) {
              host.run('hdc shell "kill -9 $(pidof ' + DEV_BIN + ')" >nul 2>&1');
              host.log('mrp stopped.', 'ok');
            }],
            FALSE: ['Start', function(data, vm) {
              if (host.exec('hdc shell pidof ' + DEV_BIN + ' 2>nul') !== '') { host.log('mrp already running on the device.', 'ok'); return; }
              // nohup 后台运行：hdc 会话断开（拔 USB）不终止 mrp，输出落设备侧日志
              host.run('hdc shell "cd ' + data.devDir + '; nohup ./' + DEV_BIN + ' >mrp.log 2>&1 &"');
              var up = false, i;
              for (i = 0; i < 5; i++) { host.run('timeout /t 1 >nul'); if (host.exec('hdc shell pidof ' + DEV_BIN + ' 2>nul') !== '') { up = true; break; } }
              host.log(up ? 'mrp started in the background on the device - output in ' + data.devDir + '/mrp.log.' : 'mrp did not start within 5 seconds.', up ? 'ok' : 'err');
            }],
          },
        },
        {
          name: 'Proxy',
          get: function(data) {
            if (!data.ready) return null;
            // hdc 无代理查询命令，沿用最近一次 Set/Clear 结果
            return [data.proxy ? 'TRUE' : 'FALSE', data.proxy ? 'Configured (127.0.0.1:' + PORT + ')' : 'Not set', data.proxy ? 'ok' : 'warn'];
          },
          state: {
            TRUE: ['Clear', function(data, vm) {
              host.run('hdc shell network-cfg set http_proxy 0');
              data.proxy = false;
              host.log('Device global proxy cleared.', 'ok');
            }],
            FALSE: ['Set', function(data, vm) {
              host.run('hdc shell network-cfg set http_proxy 127.0.0.1:' + PORT);
              data.proxy = true;
              host.log('Device global proxy set to 127.0.0.1:' + PORT + '.', 'ok');
            }],
          },
        },
      ],
      tools: [
        {
          name: 'Port forward :' + PORT,
          run: function(data, vm) {
            host.run('hdc fport tcp:' + PORT + ' tcp:' + PORT);
            host.log('Forward port :' + PORT + ' active - PC proxy target 127.0.0.1:' + PORT + '.', 'ok');
          },
        },
        {
          name: 'Port reverse :' + HTTP_PORT,
          run: function(data, vm) {
            host.run('hdc rport tcp:' + HTTP_PORT + ' tcp:' + HTTP_PORT);
            host.log('Reverse port :' + HTTP_PORT + ' active.', 'ok');
          },
        },
        {
          name: 'Open browser',
          run: function(data, vm) {
            vm.prompt('Open browser', 'URL to open on the device', 'http://127.0.0.1:' + HTTP_PORT + '/', function(url) {
              url = String(url == null ? '' : url).replace(/^\s+|\s+$/g, '');
              if (url === '') return;
              host.run('hdc shell aa start -A ohos.want.action.viewData -U "' + url + '"', false);
            });
          },
        },
        {
          name: 'DevTools',
          run: function(data, vm) {
            var probe = 'hdc shell \'cat /proc/net/unix | grep devtools | head -n 1 | cut -d @ -f2\'';
            var rc = host.run('powershell -Command "hdc fport tcp:9222 localabstract:$(' + probe + ')"', 0, true);
            host.log(rc === 0 ? 'DevTools port forwarding active.' : 'DevTools port forwarding failed rc=' + rc + '.', rc === 0 ? 'ok' : 'err');
          },
        },
        {
          name: 'Tail log',
          run: function(data, vm) {
            if (host.exec('hdc shell "test -f ' + data.devDir + '/mrp.log && echo Y" 2>nul') === '') { host.log('mrp.log not found on the device.', 'warn'); return; }
            host.run('cmd /k hdc shell "tail -n 200 -f ' + data.devDir + '/mrp.log"', 1, false);
            host.log('mrp.log tailing in a new window.', 'ok');
          },
        },
      ],
      uninstall: function(data) {
        host.run('hdc shell "kill -9 $(pidof ' + DEV_BIN + ')" >nul 2>&1');
        host.run('hdc shell network-cfg set http_proxy 0');
        host.run('hdc shell rm -f ' + data.certPath);
        host.run('hdc shell rm -rf ' + data.devDir);
        data.proxy = false;
        host.log('HarmonyOS uninstalled.', 'ok');
      },
    },
  ];

  // ---- 应用实例 ----
  new MyVue({
    el: '#app',
    data: {
      tab: 0, busy: false,
      modules: modules,
      tones: ['warn', 'dim', 'dim'],
      draft: '', modal: null,
      cur: null, tabs: [], rows: [], tools: [],
      dot: String.fromCharCode(9679)
    },
    computed: {
      cur: function() {
        return this.modules[this.tab];
      },
      tools: function() {
        return this.cur.tools;
      },
      tabs: function() {
        var out = [], j;
        for (j = 0; j < this.modules.length; j++) {
          var m = this.modules[j];
          out.push({ key: j, label: m.name, act: this.tab === j, tone: this.tones[j] });
        }
        return out;
      }
    },
    methods: {
      toVClass: function(t) {
        var o = {};
        o[t] = true;
        return o;
      },
      switchTab: function(k) {
        k = Number(k);
        if (isNaN(k) || k === this.tab) return;
        this.tab = k;
        this.render();
      },
      confirm: function(title, text, okText, cb) {
        this.modal = { title: title, text: text, okText: okText, danger: true, onOk: cb };
      },
      prompt: function(title, text, def, cb) {
        var self = this;
        this.draft = loadInput(title) || def;
        this.modal = {
          title: title,
          text: text,
          input: true,
          okText: 'OK',
          onOk: function() {
            saveInput(title, self.draft);
            cb(self.draft);
          }
        };
      },
      askUninstall: function() {
        var self = this, m = this.cur;
        this.confirm('Confirm', 'Remove all files and reset ' + m.name + '?\n\nThis cannot be undone.', 'Uninstall', function() {
          host.log('>> Uninstall', 'dim');
          m.uninstall(m.data);
          self.render();
        });
      },
      runAction: function(a) {
        var self = this, m = this.cur;
        var go = function() {
          host.log('>> ' + a.name, 'dim');
          a.run(m.data, self);
          self.render();
        };
        if (a.danger) this.confirm('Confirm', 'Run "' + a.name + '" on ' + m.name + '?', a.name, go);
        else go();
      },
      rowAct: function(r) {
        if (!r || !r.fn) return;
        var self = this, m = this.cur;
        var go = function() {
          host.log('>> ' + r.act, 'dim');
          r.fn(m.data, self);
          self.render();
        };
        if (r.danger) this.confirm('Confirm', 'Run "' + r.act + '" on ' + m.name + '?', r.act, go);
        else go();
      },
      render: function() {
        var m = this.cur, out = [], j;
        for (j = 0; j < m.states.length; j++) {
          var st = m.states[j], v = st.get(m.data);
          if (!v) continue;
          var btn = st.state ? st.state[v[0]] : null;
          out.push({ name: st.name, tone: v[2], text: v[1], act: btn ? btn[0] : '', danger: btn ? !!btn[2] : false, fn: btn ? btn[1] : null });
        }
        this.rows = out;
        this.tones[this.tab] = m.health(m.data);
      },
      refresh: function() {
        if (this.busy) return;
        var self = this, m = this.cur;
        this.busy = true;
        host.log('Refreshing ' + m.name + '...', 'dim');
        setTimeout(function() {
          try {
            self.render();
            host.log('Probed ' + m.name + ': ' + self.tones[self.tab] + '.');
          } finally {
            self.busy = false;
          }
        }, 50);
      },
      clearLog: function() {
        logClear();
      },
      modalOk: function() {
        var m = this.modal;
        this.modal = null;
        if (m && m.onOk) m.onOk.call(this);
      },
      modalNo: function() {
        this.modal = null;
      }
    },
    mounted: function() {
      var self = this;
      win.onerror = function(msg, url, line) {
        host.log('window error: ' + msg + ' (line ' + (line || '?') + ')', 'err');
        return false;
      };
      var keyfn = function(e) {
        e = e || win.event;
        var c = e.keyCode || e.which || e.charCode;
        if (self.modal) { if (c === 27) self.modalNo(); return; }
        var tag = ((e.target && e.target.tagName) || '').toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (c === 116 || (c === 82 && (e.ctrlKey || e.metaKey))) {
          if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
          self.refresh();
        }
      };
      if (doc.addEventListener) doc.addEventListener('keydown', keyfn, false);
      else doc.attachEvent('onkeydown', keyfn);
      host.log('workdir=' + host.workdir + ' - click Refresh to probe modules.');
      self.render();
    }
  });

})(window, document);
</script>
</body>
</html>