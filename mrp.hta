<!DOCTYPE html>
<!--
  MRP Helper
  UTF-8 保存为 mrp.hta 双击运行；拖入浏览器仅显示界面，动作不可用。
  渲染路径全 ASCII：中文用数字实体，圆点用 fromCharCode。
  链接不带 href：HTA NAVIGABLE=no 会把 javascript: 交给默认浏览器，
  手型与颜色由 CSS 提供，@事件统一 preventDefault。
-->
<html lang="zh-CN">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>MRP Helper</title>
<HTA:APPLICATION ID="htaMrp" APPLICATIONNAME="MRP-HELPER" SINGLEINSTANCE="yes" CONTEXTMENU="no" NAVIGABLE="no" />
<script>try { window.resizeTo(880, 860); } catch (ex) {}</script>
<style>
html,body{height:100%;margin:0;font:14px/1.7 "Segoe UI","Microsoft YaHei",sans-serif}
#nav{position:absolute;left:0;top:0;bottom:0;width:140px;border-right:1px solid #eee;padding-top:8px;overflow-y:auto}
#nav a{display:block;padding:8px 16px;border-left:3px solid transparent;color:#333;text-decoration:none}
#nav a.act{border-left-color:#1677ff;background:#f5f8ff;color:#1677ff;font-weight:bold}
#main{position:absolute;left:141px;top:0;right:0;bottom:0}
#top{position:absolute;left:0;right:0;top:0;bottom:320px;padding:6px 14px 0;overflow-y:auto}
fieldset{border:1px solid #e0e0e0;border-radius:4px;margin:0 0 10px;padding:0 12px 8px;min-width:0}
legend{font-size:12px;color:#666;padding:0 6px}
a{color:#1677ff;text-decoration:none;cursor:pointer}
button{background:none;border:0;color:#1677ff;padding:3px 10px;cursor:pointer;font:inherit}
table{width:100%;border-collapse:collapse}
td{border-bottom:1px solid #f5f5f5;padding:8px 4px}
#acts a{margin-right:16px}
#con{position:absolute;left:14px;right:14px;top:330px;bottom:10px;margin:0;padding:0 12px 8px}
pre{position:absolute;left:12px;right:12px;top:24px;bottom:8px;border:1px solid #eee;overflow-y:auto;font:12px/19px Consolas,monospace;margin:0;white-space:pre-wrap;word-break:break-all;box-sizing:border-box}
.dim{color:#999}.ok{color:#52c41a}.warn{color:#e6a23c}.err{color:#ff4d4f}
#mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.3)}
#box{position:fixed;top:30%;left:50%;width:330px;margin-left:-165px;background:#fff;border:1px solid #bbb;padding:12px}
#box p{white-space:pre-line}
#box input{width:100%;margin:8px 0;box-sizing:border-box}
</style>
</head>
<body>

<div id="app">
  <nav id="nav">
    <a v-for="t in tabs" v-class="{act: t.act}" @click="switchTab(t.key)">
      <span>{{ t.label }}</span> <i v-class="dotCls(t.tone)">{{ dot }}</i>
    </a>
  </nav>
  <main id="main">
    <div id="top">
      <fieldset>
        <legend>STATUS &#183; <a v-class="{dim: busy}" @click="refresh">{{ busy ? 'Refreshing...' : 'Refresh' }}</a> &#183; <a class="err" @click="askUninstall">Uninstall</a></legend>
        <table>
          <tr v-for="r in rows">
            <td width="120">{{ r.name }}</td>
            <td><i v-class="dotCls(r.tone)">{{ dot }}</i> {{ r.text }}</td>
            <td align="right"><a v-if="r.act" v-class="{err: r.danger}" @click="rowAct(r)">{{ r.act }}</a></td>
          </tr>
        </table>
      </fieldset>
      <fieldset>
        <legend>TOOLS</legend>
        <p id="acts"><a v-for="a in tools" v-class="{err: a.danger}" @click="runAction(a)">{{ a.name }}</a></p>
      </fieldset>
    </div>
    <fieldset id="con">
      <legend>CONSOLE &#183; <a @click="clearLog">Clear</a></legend>
      <pre id="log"></pre>
    </fieldset>
  </main>
  <div id="mask" v-if="modal">
    <div id="box">
      <b>{{ modal ? modal.title : '' }}</b>
      <p>{{ modal ? modal.text : '' }}</p>
      <input v-if="modal && modal.input" v-model="draft" @keydown.enter="modalOk" />
      <p align="right"><button v-class="{err: modal && modal.danger}" @click="modalOk">{{ modal ? modal.okText : 'OK' }}</button> <button @click="modalNo">Cancel</button></p>
    </div>
  </div>
</div>

<script>
(function(win, doc) {
  'use strict';

  // ---- 常量 ----
  var PORT = '8000',
      CA_HASH = 'd6cd00d8',
      CA_CN = 'DeviceProxy CA',
      CRT = 'ca.crt',
      KEY = 'ca.key',
      DEV_CFG = 'config.yaml',
      DEV_BIN = 'mrp-linux-arm64',
      MRP_EXE = 'mrp-windows-amd64.exe';

  var CA_CERT = [
    '-----BEGIN CERTIFICATE-----',
    'MIIBmDCCAT2gAwIBAgIUVfZslYEayBAiv6+V9lA5ktPf9jYwCgYIKoZIzj0EAwIw',
    'GTEXMBUGA1UEAwwORGV2aWNlUHJveHkgQ0EwHhcNMjYwOTI5MDMwNTQzWhcNMzYw',
    'OTI2MDMwNTQzWjAZMRcwFQYDVQQDDA5EZXZpY2VQcm94eSBDQTBZMBMGByqGSM49',
    'AgEGCCqGSM49AwEHA0IABCh7WdaFBMOCXNjbRjaICJfAGQ2uCcBjKE+mDiqxCzxL',
    '9LbtiJm7iKZDg7FUvb6vPGdRSHhYUIwlAIDbgBTTQJmjYzBhMB0GA1UdDgQWBBTo',
    'tHWQTTk1+kp3Gn/omx7RbgFd6TAfBgNVHSMEGDAWgBTotHWQTTk1+kp3Gn/omx7R',
    'bgFd6TAPBgNVHRMBAf8EBTADAQH/MA4GA1UdDwEB/wQEAwIChDAKBggqhkjOPQQD',
    'AgNJADBGAiEAsrLEFOvjAceXTc2WfnFCAoU0sGFVWrbOy3mj0A0r3CYCIQDYLtbX',
    'It95OQr70jbFEwPw4mcqqHVaq59Vg35lGsF50Q==',
    '-----END CERTIFICATE-----'
  ];
  var CA_KEY = [
    '-----BEGIN PRIVATE KEY-----',
    'MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgkFv91z9F6RVPe5cI',
    'cKsnH6OQt66aQXn3bB+mQqJo+j2hRANCAAQoe1nWhQTDglzY20Y2iAiXwBkNrgnA',
    'YyhPpg4qsQs8S/S27YiZu4imQ4OxVL2+rzxnUUh4WFCMJQCA24AU00CZ',
    '-----END PRIVATE KEY-----'
  ];

  // ---- 环境检测 ----
  var hasShell = false;
  try {
    hasShell = (typeof ActiveXObject !== 'undefined') && !!new ActiveXObject('WScript.Shell');
  } catch (ex) {}

  var WORKDIR = (function() {
    var s = unescape(location.href).replace(/\+/g, ' ').replace(/^file:\/\/\//i, '').replace(/\//g, '\\');
    return s.substring(0, s.lastIndexOf('\\') + 1);
  })();

  // ---- 日志 ----
  var logBox = null;
  function pad2(n) { n = String(n); return n.length < 2 ? '0' + n : n; }

  function log(text, lv) {
    var box = logBox || (logBox = doc.getElementById('log'));
    if (!box) return;
    var d = doc.createElement('div');
    if (lv) d.className = lv;
    var t = new Date();
    d.innerHTML = '<i class="dim">[' + pad2(t.getHours()) + ':' + pad2(t.getMinutes()) + ':' + pad2(t.getSeconds()) + ']</i> ' +
      String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    box.appendChild(d);
    while (box.children.length > 300) box.removeChild(box.firstChild);
    box.scrollTop = box.scrollHeight;
  }

  function logClear() {
    if (logBox) logBox.innerHTML = '';
  }

  // ---- Shell 操作 ----
  function runRaw(cmd, show, wait) {
    try { return new ActiveXObject('WScript.Shell').Run(cmd, show, wait); }
    catch (ex) { return 1; }
  }

  function runWait(cmd, show) {
    if (cmd.indexOf('timeout ') !== 0) log('> ' + cmd, 'dim');
    return runRaw('%comspec% /c "' + cmd + '"', show ? 1 : 0, true);
  }

  function execText(cmd) {
    try {
      var sh = new ActiveXObject('WScript.Shell'),
          fso = new ActiveXObject('Scripting.FileSystemObject'),
          tmp = WORKDIR + '_mrp_out.txt';
      sh.Run('%comspec% /c (' + cmd + ') > "' + tmp + '"', 0, true);
      var out = '';
      if (fso.FileExists(tmp)) {
        var f = fso.OpenTextFile(tmp, 1, false, 0);
        if (!f.AtEndOfStream) out = f.ReadAll();
        f.Close();
        try { fso.DeleteFile(tmp); } catch (ex) {}
      }
      return out;
    } catch (ex) { return ''; }
  }

  function fileExists(name) {
    return hasShell ? new ActiveXObject('Scripting.FileSystemObject').FileExists(WORKDIR + name) : false;
  }

  function writeFileText(name, lines) {
    try {
      var f = new ActiveXObject('Scripting.FileSystemObject').CreateTextFile(WORKDIR + name, true, false);
      for (var i = 0; i < lines.length; i++) f.WriteLine(lines[i]);
      f.Close();
    } catch (ex) {}
  }

  function deleteFiles(names) {
    try {
      var fso = new ActiveXObject('Scripting.FileSystemObject'), i;
      for (i = 0; i < names.length; i++) {
        if (fso.FileExists(WORKDIR + names[i])) fso.DeleteFile(WORKDIR + names[i], true);
      }
    } catch (ex) {}
  }

  // ---- 输入持久化 ----
  var inputCache = {}, INPUT_FILE = WORKDIR + '_mrp_inputs.txt';

  (function() {
    if (!hasShell) return;
    try {
      var fso = new ActiveXObject('Scripting.FileSystemObject');
      if (!fso.FileExists(INPUT_FILE)) return;
      var lines = fso.OpenTextFile(INPUT_FILE, 1, false, 0).ReadAll().split('\r\n');
      for (var i = 0; i < lines.length; i++) {
        var idx = lines[i].indexOf('\t');
        if (idx > 0) inputCache[lines[i].substring(0, idx)] = lines[i].substring(idx + 1);
      }
    } catch (ex) {}
  })();

  function flushInput() {
    if (!hasShell) return;
    try {
      var f = new ActiveXObject('Scripting.FileSystemObject').CreateTextFile(INPUT_FILE, true, false);
      for (var k in inputCache) {
        if (Object.prototype.hasOwnProperty.call(inputCache, k)) {
          f.WriteLine(k + '\t' + inputCache[k]);
        }
      }
      f.Close();
    } catch (ex) {}
  }

  function loadInput(key) { return inputCache[key] || ''; }
  function saveInput(key, value) { if (hasShell) inputCache[key] = value; }
  win.onbeforeunload = flushInput;

  // ---- 状态单元格 ----
  function cell(tone, text, act, danger) {
    return { tone: tone, text: text, act: act || '', danger: !!danger };
  }

  // ---- 宿主接口 ----
  var host = {
    workdir: WORKDIR,
    log: log,
    run: runWait,
    runRaw: runRaw,
    exec: execText,
    fileExists: fileExists,
    writeText: writeFileText,
    deleteFiles: deleteFiles
  };

  // ---- MyVue 响应式引擎 ----
  // 核心：defineProperty 劫持 + 依赖追踪 + 模板编译
  function MyVue(options) {
    var self = this,
        _ecache = {},
        _collect = null,
        _errSeen = {},
        _depth = 0;

    this.$el = doc.querySelector(options.el || '#app');
    this.$data = typeof options.data === 'function' ? options.data() : (options.data || {});
    this._deps = {};
    this._ctx = {};

    function each(obj, fn) {
      for (var k in obj) if (Object.prototype.hasOwnProperty.call(obj, k)) fn(obj[k], k);
    }

    function on(el, ev, fn) {
      if (el.addEventListener) el.addEventListener(ev, fn, false);
      else if (el.attachEvent) el.attachEvent('on' + ev, fn);
    }

    function toggleClass(el, c, add) {
      var cn = el.className.split(/\s+/), i = cn.indexOf(c);
      if (add && i < 0) cn.push(c);
      if (!add && i >= 0) cn.splice(i, 1);
      el.className = cn.join(' ').replace(/^\s+|\s+$/g, '');
    }

    function report(msg) {
      if (_errSeen[msg]) return;
      _errSeen[msg] = 1;
      if (options.onerror) options.onerror('[kernel] ' + msg);
    }

    function getPath(key) {
      var ks = key.split('.'), o = self.$data, i;
      for (i = 0; i < ks.length && o != null; i++) o = o[ks[i]];
      return o;
    }

    function setPath(key, value) {
      var ks = key.split('.'), o = self.$data, i;
      for (i = 0; i < ks.length - 1; i++) {
        o = o[ks[i]];
        if (o == null) return;
      }
      o[ks[i]] = value;
    }

    function addDep(path, fn) {
      var a = self._deps[path] || (self._deps[path] = []);
      if (a.indexOf(fn) < 0) a.push(fn);
    }

    function delDep(path, fn) {
      var a = self._deps[path], i;
      if (a && (i = a.indexOf(fn)) >= 0) a.splice(i, 1);
    }

    function notify(path) {
      var queues = [];
      each(self._deps, function(subs, key) {
        if (path === key || path.indexOf(key + '.') === 0) queues.push(subs.slice());
      });
      for (var i = 0; i < queues.length; i++) {
        for (var j = 0; j < queues[i].length; j++) {
          if (++_depth > 200) {
            _depth--;
            report('update cascade exceeded 200 levels at path "' + path + '"');
            return;
          }
          try { queues[i][j](); }
          catch (ex) { report('update: ' + (ex && ex.message ? ex.message : ex)); }
          _depth--;
        }
      }
    }

    function defineReactive(obj, key, val, path) {
      if (val && typeof val === 'object') walk(val, path);
      Object.defineProperty(obj, key, {
        get: function() {
          if (_collect && _collect.indexOf(path) < 0) _collect.push(path);
          return val;
        },
        set: function(nv) {
          if (nv === val) return;
          val = nv;
          notify(path);
        }
      });
    }

    function walk(obj, base) {
      each(obj, function(v, k) {
        if (k !== 'length') defineReactive(obj, k, v, base ? base + '.' + k : k);
      });
    }

    function evalExpr(expr, $s) {
      var fn = _ecache[expr] || (_ecache[expr] = new Function('$c', '$s', 'with($c){with($s||{}){return (' + expr + ');}}'));
      try { return fn.call(self._ctx, self._ctx, $s); }
      catch (ex) { report('expr "' + expr + '": ' + (ex && ex.message ? ex.message : ex)); return undefined; }
    }

    function track(run) {
      var own = {};
      function fire() {
        var prev = _collect, paths, i, k;
        _collect = [];
        try { run(); }
        finally { paths = _collect; _collect = prev; }
        var fresh = {};
        for (i = 0; i < paths.length; i++) {
          fresh[paths[i]] = 1;
          if (!own[paths[i]]) {
            own[paths[i]] = 1;
            addDep(paths[i], fire);
          }
        }
        for (k in own) if (!fresh[k]) { delDep(k, fire); delete own[k]; }
      }
      fire();
      return fire;
    }

    function computed(key, fn) {
      var last;
      track(function() {
        var nv = fn.call(self._ctx);
        if (nv !== last) { last = nv; self.$data[key] = nv; }
      });
    }

    function bindText(node, $s) {
      var src = node.nodeValue, re = /\{\{\s*([^}]+?)\s*\}\}/g;
      if (!re.test(src)) return;
      re.lastIndex = 0;
      var frag = doc.createDocumentFragment(), binds = [], last = 0, m, tn;
      while ((m = re.exec(src))) {
        if (m.index > last) frag.appendChild(doc.createTextNode(src.slice(last, m.index)));
        tn = doc.createTextNode('');
        frag.appendChild(tn);
        binds.push({ tn: tn, expr: m[1] });
        last = m.index + m[0].length;
      }
      if (last < src.length) frag.appendChild(doc.createTextNode(src.slice(last)));
      node.parentNode.replaceChild(frag, node);
      for (var i = 0; i < binds.length; i++) bindSeg(binds[i], $s);
    }

    function bindSeg(seg, $s) {
      track(function() {
        var v = evalExpr(seg.expr, $s), s2 = v == null ? '' : String(v);
        if (seg.tn.nodeValue !== s2) seg.tn.nodeValue = s2;
      });
    }

    function bindEvent(el, spec, $s) {
      var dot = spec.name.substring(1).split('.'), ev = dot[0], kc = dot[1] === 'enter' ? 13 : 0;
      var m2 = spec.value.replace(/^\s+|\s+$/g, '').match(/^([\w$]+)\s*(?:\((.*)\))?$/);
      var argFn = (m2 && m2[2]) ? m2[2] : null;
      on(el, ev, function(e) {
        e = e || win.event;
        if (kc && (e.keyCode || e.which) !== kc) return;
        if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
        if (!m2) { report('bad handler: ' + spec.value); return; }
        var fn2 = self._ctx[m2[1]];
        if (!fn2) { report('handler not found: ' + spec.value); return; }
        try { fn2(argFn ? evalExpr(argFn, $s) : e); }
        catch (ex) { report(spec.value + ' -> ' + (ex && ex.message ? ex.message : ex)); }
      });
    }

    function setupFor(el, expr) {
      var m = expr.match(/^\s*([\w$]+)\s+in\s+(.+?)\s*$/), parent = el.parentNode;
      if (!m || !parent) return;
      var name = m[1], listExpr = m[2];
      var anchor = doc.createComment('v-for');
      parent.insertBefore(anchor, el);
      parent.removeChild(el);
      var tpl = el.cloneNode(true);
      tpl.removeAttribute('v-for');
      track(function() {
        try {
          var list = evalExpr(listExpr) || [], n, i;
          while ((n = anchor.nextSibling) && n._vfor) parent.removeChild(n);
          var after = anchor.nextSibling;
          for (i = 0; i < list.length; i++) {
            var node = tpl.cloneNode(true);
            node._vfor = 1;
            parent.insertBefore(node, after);
            var $s = {};
            $s[name] = list[i];
            compile(node, $s);
          }
        } catch (ex) { report('v-for "' + listExpr + '": ' + (ex && ex.message ? ex.message : ex)); }
      });
    }

    function compile(el, $s) {
      if (!el || !el.getAttribute) return;
      var vfor = el.getAttribute('v-for');
      if (vfor) { setupFor(el, vfor); return; }
      var nodes = el.childNodes, arr = [], i, n;
      for (i = 0; i < nodes.length; i++) arr.push(nodes[i]);
      for (i = 0; i < arr.length; i++) {
        n = arr[i];
        if (n.nodeType === 3) bindText(n, $s);
        else compile(n, $s);
      }
      var modelKey = el.getAttribute('v-model');
      if (modelKey) {
        var h = function() { setPath(modelKey, el.value); };
        on(el, 'input', h); on(el, 'change', h);
        track(function() {
          var v = getPath(modelKey), s2 = v == null ? '' : String(v);
          if (el.value !== s2) el.value = s2;
        });
      }
      var ifExpr = el.getAttribute('v-if');
      if (ifExpr) {
        var ph = doc.createComment('v-if'), shown = true;
        track(function() {
          var v = evalExpr(ifExpr, $s);
          if (v && !shown && ph.parentNode) { ph.parentNode.replaceChild(el, ph); shown = true; }
          else if (!v && shown && el.parentNode) { el.parentNode.replaceChild(ph, el); shown = false; }
        });
      }
      var clsExpr = el.getAttribute('v-class');
      if (clsExpr) {
        track(function() {
          var map = evalExpr(clsExpr, $s);
          if (map) for (var c in map) if (Object.prototype.hasOwnProperty.call(map, c)) toggleClass(el, c, !!map[c]);
        });
      }
      var atts = el.attributes;
      for (i = 0; i < atts.length; i++) if (atts[i].name.charAt(0) === '@') bindEvent(el, atts[i], $s);
    }

    walk(this.$data, '');
    each(this.$data, function(v, k) {
      Object.defineProperty(self._ctx, k, {
        get: function() { return self.$data[k]; },
        set: function(nv) { self.$data[k] = nv; }
      });
    });
    each(options.methods || {}, function(fn, k) { self._ctx[k] = fn.bind(self._ctx); });
    if (options.computed) each(options.computed, function(fn, k) { computed(k, fn); });
    compile(this.$el, null);
    if (options.mounted) options.mounted.call(this._ctx);
  }

  // ---- CA 证书管理 ----
  function ensureCA() {
    if (!host.fileExists(CRT)) host.writeText(CRT, CA_CERT);
    if (!host.fileExists(KEY)) host.writeText(KEY, CA_KEY);
  }

  // ---- Windows 模块 ----
  function createWindowsModule() {
    function checkFiles(s) {
      var want = [MRP_EXE, CRT, KEY], miss = [], i;
      for (i = 0; i < want.length; i++) if (!host.fileExists(want[i])) miss.push(want[i]);
      s.filesOK = miss.length === 0;
      s.miss = miss;
    }

    function proxyOn() {
      return host.exec('netsh winhttp show proxy 2>nul').indexOf('127.0.0.1:' + PORT) >= 0;
    }

    function setProxy(cmd, expectOn) {
      if (host.exec('net session >nul 2>&1 && echo OK') === '') {
        var ps = 'powershell -NoProfile -Command "Start-Process -FilePath cmd.exe -Verb RunAs -Wait -ArgumentList \'/c ' + cmd.replace(/'/g, "''") + "'\"";
        host.log('> ' + cmd + ' [runas]', 'dim');
        host.runRaw(ps, 0, true);
      } else {
        host.run(cmd);
      }
      return proxyOn() === expectOn;
    }

    function procRunning() {
      return host.exec('tasklist /fi "imagename eq ' + MRP_EXE + '" /nh 2>nul').toLowerCase().indexOf(MRP_EXE.toLowerCase()) >= 0;
    }

    function stopProc() {
      if (procRunning()) host.run('taskkill /im "' + MRP_EXE + '" /f');
    }

    function certState() {
      if (!host.fileExists(CRT)) return 'NONE';
      var dump = host.exec('certutil -dump "' + host.workdir + CRT + '"').toLowerCase();
      var m = dump.match(/cn=([^,\r\n]+)/);
      if (!m) return 'NONE';
      var cn = m[1];
      if (host.exec('certutil -store Root 2>nul').toLowerCase().indexOf('cn=' + cn) >= 0) return 'MACHINE';
      if (host.exec('certutil -user -store Root 2>nul').toLowerCase().indexOf('cn=' + cn) >= 0) return 'USER';
      return 'NONE';
    }

    function removeUserCA() {
      host.run('powershell -NoProfile -Command "Get-ChildItem Cert:\\CurrentUser\\Root | Where-Object {$_.Subject -eq \'CN=' + CA_CN + '\' } | Remove-Item -Force" >nul 2>&1');
    }

    return {
      name: 'Windows',
      data: { filesOK: true, miss: [], cert: 'NONE', run: false, proxy: false },
      states: [
        { name: 'Files', get: function(s) { return s.filesOK ? cell('ok', 'OK') : cell('err', s.miss.length ? 'Missing: ' + s.miss.join(', ') : 'Missing files', 'Locate files'); } },
        { name: 'CA certificate', get: function(s) { return s.cert === 'NONE' ? cell('warn', 'Not imported', 'Import CA') : cell('ok', 'Imported [' + s.cert + ']', 'Remove', true); } },
        { name: 'mrp process', get: function(s) { return s.run ? cell('ok', 'Running', 'Stop') : cell('warn', 'Stopped', 'Start'); } },
        { name: 'Proxy', get: function(s) { return s.proxy ? cell('ok', 'Configured (127.0.0.1:' + PORT + ')', 'Clear') : cell('warn', 'Not set', 'Set'); } }
      ],
      actions: [
        { name: 'Locate files', run: function(s) {
            ensureCA(); checkFiles(s);
            if (s.filesOK) { host.log('Files ready.', 'ok'); return; }
            host.log('Missing: ' + s.miss.join(', ') + ' in ' + host.workdir + '. Download from GitHub Releases.', 'err');
          } },
        { name: 'Import CA', run: function(s) {
            ensureCA(); var cs = certState();
            if (cs !== 'NONE') { host.log('Already imported - ' + cs + '.', 'ok'); return; }
            var code = host.run('certutil -user -addstore Root "' + host.workdir + CRT + '"');
            if (code === 0) { s.cert = 'USER'; host.log('CA imported into the user Root store.', 'ok'); }
            else host.log('CA import failed.', 'err');
          } },
        { name: 'Remove', danger: true, run: function(s) { removeUserCA(); s.cert = 'NONE'; host.log('CA removed.', 'ok'); } },
        { name: 'Start', run: function(s) {
            if (procRunning()) { host.log('mrp already running.', 'ok'); return; }
            host.run('start "mrp" /D "' + host.workdir + '" "' + host.workdir + MRP_EXE + '"', true);
            s.run = true; host.log('mrp started in a new window.', 'ok');
          } },
        { name: 'Stop', run: function(s) { stopProc(); s.run = false; host.log('mrp stopped.', 'ok'); } },
        { name: 'Set', run: function(s) {
            var ok = setProxy('netsh winhttp set proxy 127.0.0.1:' + PORT, true);
            s.proxy = true;
            host.log(ok ? 'System proxy set to 127.0.0.1:' + PORT + '.' : 'Warning: proxy not applied.', ok ? 'ok' : 'warn');
          } },
        { name: 'Clear', run: function(s) {
            var ok = setProxy('netsh winhttp reset proxy', false);
            s.proxy = false;
            host.log(ok ? 'System proxy cleared.' : 'Warning: proxy not cleared.', ok ? 'ok' : 'warn');
          } }
      ],
      probe: function(s) { checkFiles(s); s.cert = certState(); s.run = procRunning(); s.proxy = proxyOn(); },
      health: function(s) { return s.filesOK && s.cert !== 'NONE' && s.run ? 'ok' : 'warn'; },
      summary: function() { return ''; },
      uninstall: function(s) {
        if (!setProxy('netsh winhttp reset proxy', false)) {
          host.log('Warning: system proxy may still be set; clear it manually.', 'warn');
        }
        stopProc(); removeUserCA();
        host.deleteFiles([MRP_EXE, CRT, KEY]);
        s.filesOK = false; s.cert = 'NONE'; s.run = false; s.proxy = false;
        host.log('Windows module uninstalled.', 'ok');
      }
    };
  }

  // ---- 设备模块 (adb/hdc 通用) ----
  function createDeviceModule(cfg) {
    var isAdb = cfg.tool === 'adb';
    var devDir = '/data/local/mrp';
    var certPath = cfg.certDir + '/' + CA_HASH + '.0';

    function ensureDevDir() { host.run(cfg.tool + ' shell mkdir -p ' + devDir); }
    function pushDev(file, dest) { return host.run(cfg.tool + ' ' + cfg.pushCmd + ' "' + host.workdir + file + '" ' + (dest || devDir)); }
    function devFileExists(path) { return host.exec(cfg.tool + ' shell "test -f ' + path + ' && echo Y" 2>nul') !== ''; }
    function binRunning() { return host.exec(cfg.tool + ' shell pidof ' + DEV_BIN + ' 2>nul') !== ''; }
    function stopBin() { host.run(cfg.tool + ' shell pkill -f ' + DEV_BIN + ' >nul 2>&1'); }

    function remount() {
      host.run(cfg.tool + ' root');
      host.run('timeout /t 3 >nul');
      host.run(cfg.tool + ' wait-for-device');
      host.run(cfg.tool + ' remount');
    }

    function parseTargets(out) {
      if (isAdb) {
        var desc = '', i;
        for (i = 1; i < out.length; i++) {
          var c = out[i].replace(/\r/g, '').split(/\s+/);
          if (c.length >= 2 && c[1] === 'device') { desc = c[0]; break; }
        }
        return desc;
      }
      var d = '', j;
      for (j = 0; j < out.length; j++) {
        var t = out[j].replace(/\s+/g, '');
        if (t !== '') d = t;
      }
      var head = d.substring(0, 7);
      if (d === '' || head === '[Empty]' || head === 'Connect') d = '';
      return d;
    }

    function installCert() {
      if (isAdb) {
        remount(); pushDev(CRT, certPath);
        host.run(cfg.tool + ' shell chmod 644 ' + certPath);
      } else {
        var tmp = '%TEMP%\\' + CA_HASH + '.0';
        host.run('copy /y "' + host.workdir + CRT + '" "' + tmp + '" >nul');
        host.run(cfg.tool + ' ' + cfg.pushCmd + ' "' + tmp + '" ' + cfg.certDir);
      }
    }

    function remountForCert() { if (isAdb) remount(); }

    return {
      name: cfg.name,
      data: { ready: false, desc: '', bin: false, cert: false, run: false, proxy: false },
      states: [
        { name: 'Device', get: function(s) { return s.ready ? cell('ok', s.desc, 'Sync config') : cell('idle', s.desc || 'Not probed yet; click Refresh to check.'); } },
        { name: 'Files', get: function(s) { if (!s.ready) return null; return s.bin ? cell('ok', 'Installed') : cell('warn', 'Not installed', 'Install files'); } },
        { name: 'CA certificate', get: function(s) { if (!s.ready) return null; return s.cert ? cell('ok', 'Installed', 'Remove', true) : cell('warn', 'Not installed', 'Install CA'); } },
        { name: 'mrp process', get: function(s) { if (!s.ready) return null; if (!s.bin) return cell('err', 'Not installed'); return s.run ? cell('ok', 'Running', 'Stop') : cell('warn', 'Stopped', 'Start'); } },
        { name: 'Proxy', get: function(s) { if (!s.ready) return null; if (!cfg.known) return cell('idle', 'Unknown'); return s.proxy ? cell('ok', 'Configured (127.0.0.1:' + PORT + ')', 'Clear') : cell('warn', 'Not set', 'Set'); } }
      ],
      actions: [].concat([
        { name: 'Sync config', run: function(s) {
            if (!host.fileExists(DEV_CFG)) { host.log(DEV_CFG + ' not found next to this script.', 'err'); return; }
            ensureDevDir();
            if (pushDev(DEV_CFG) !== 0) { host.log('Sync failed; check device connection.', 'err'); return; }
            host.log(DEV_CFG + ' synced - mrp hot reloads it automatically.', 'ok');
          } },
        { name: 'Install files', run: function(s) {
            ensureCA(); ensureDevDir();
            var rc = pushDev(DEV_BIN);
            if (rc !== 0) { host.log(DEV_BIN + ' push failed (rc=' + rc + '). Download it from GitHub Releases into ' + host.workdir, 'err'); return; }
            if (host.fileExists(DEV_CFG)) pushDev(DEV_CFG);
            var bad = [];
            if (pushDev(CRT) !== 0) bad.push(CRT);
            if (pushDev(KEY) !== 0) bad.push(KEY);
            host.run(cfg.tool + ' shell chmod +x ' + devDir + '/' + DEV_BIN);
            s.bin = true;
            host.log(bad.length ? 'Binary installed, but push failed for: ' + bad.join(', ') + '.' : 'Device files installed.', bad.length ? 'warn' : 'ok');
          } },
        { name: 'Install CA', run: function(s) {
            ensureCA(); installCert();
            var ok = devFileExists(certPath);
            if (ok) s.cert = true;
            host.log(ok ? 'CA installed.' : 'Warning: cert install may have failed; ensure the device is rooted or in developer mode.', ok ? 'ok' : 'warn');
          } },
        { name: 'Remove', danger: true, run: function(s) {
            remountForCert();
            host.run(cfg.tool + ' shell rm -f ' + certPath);
            s.cert = false; host.log('CA removed.', 'ok');
          } },
        { name: 'Start', run: function(s) {
            if (binRunning()) { host.log('mrp already running on device.', 'ok'); return; }
            var consoleCmd = 'cmd /k ' + cfg.tool + ' shell "cd ' + devDir + '; ./' + DEV_BIN + '"';
            host.log('> ' + consoleCmd, 'dim');
            try { host.runRaw(consoleCmd, 1, false); }
            catch (ex) { host.log('Failed to open device console window.', 'err'); return; }
            var up = false, i;
            for (i = 0; i < 5; i++) { host.run('timeout /t 1 >nul'); if (binRunning()) { up = true; break; } }
            s.run = up;
            host.log(up ? 'mrp is now running on device - Ctrl+C in the new window to stop.' : 'Warning: mrp did not start within 5 seconds.', up ? 'ok' : 'err');
          } },
        { name: 'Stop', run: function(s) { stopBin(); s.run = false; host.log('mrp stopped.', 'ok'); } }
      ], cfg.known ? [
        { name: 'Set', run: function(s) { host.run(cfg.tool + ' ' + cfg.proxySet); s.proxy = true; host.log('Device global proxy set to 127.0.0.1:' + PORT + '.', 'ok'); } },
        { name: 'Clear', run: function(s) { host.run(cfg.tool + ' ' + cfg.proxyClear); s.proxy = false; host.log('Device global proxy cleared.', 'ok'); } }
      ] : [], [
        { name: 'Port reverse :8000', tool: true, run: function(s) { host.run(cfg.tool + ' ' + cfg.reverseCmd); host.log('Port reverse :8000 active.', 'ok'); } },
        { name: 'Open browser', tool: true, run: function(s, vm) {
            vm.prompt('Open browser', 'URL to open on the device', 'http://example.com', function(url) {
              url = String(url == null ? '' : url).replace(/^\s+|\s+$/g, '');
              if (url === '') return;
              if (/[&|^<>"'%\s]/.test(url)) { host.log('URL contains shell-hostile characters; skipped.', 'warn'); return; }
              host.run((cfg.tool + ' ' + cfg.openUrl).replace(/\{URL\}/g, url), true);
            });
          } },
        { name: 'DevTools', tool: true, run: function(s) { host.run(cfg.tool + ' ' + cfg.devtoolsCmd); host.log('DevTools port forwarded.', 'ok'); } }
      ]),
      probe: function(s) {
        if (host.exec('where ' + cfg.tool + ' >nul 2>&1 && echo OK') === '') { s.ready = false; s.desc = 'Not installed'; return; }
        var out = host.exec(cfg.tool + ' ' + cfg.listCmd + ' 2>nul').split('\n');
        var desc = parseTargets(out);
        if (!desc) { s.ready = false; s.desc = 'No device connected'; return; }
        s.ready = true; s.desc = desc;
        s.cert = devFileExists(certPath);
        s.bin = devFileExists(devDir + '/' + DEV_BIN);
        s.run = binRunning();
        s.proxy = cfg.known ? host.exec(cfg.tool + ' shell settings get global http_proxy 2>nul').indexOf('127.0.0.1:' + PORT) === 0 : false;
      },
      health: function(s) {
        if (!s.ready) return 'idle';
        if (s.cert && s.bin && s.run) return 'ok';
        if (s.cert || s.bin) return 'warn';
        return 'err';
      },
      summary: function(s) { return ' (' + (s.desc || 'none') + ')'; },
      uninstall: function(s) {
        stopBin();
        if (cfg.known) host.run(cfg.tool + ' ' + cfg.proxyClear);
        remountForCert();
        host.run(cfg.tool + ' shell rm -f ' + certPath);
        host.run(cfg.tool + ' shell rm -rf ' + devDir);
        s.bin = false; s.cert = false; s.run = false; s.proxy = false;
        host.log(cfg.name + ' uninstall finished.', 'ok');
      }
    };
  }

  // ---- 应用实例 ----
  new MyVue({
    el: '#app',
    data: {
      tab: 0, busy: false,
      modules: (function() {
        var list = [];
        try { list.push(createWindowsModule()); }
        catch (ex) { log('Windows module init failed: ' + ex, 'err'); }
        try { list.push(createDeviceModule({
          name: 'Android', tool: 'adb', known: true,
          certDir: '/system/etc/security/cacerts',
          pushCmd: 'push', listCmd: 'devices',
          devtoolsCmd: 'forward tcp:9222 localabstract:chrome_devtools_remote',
          reverseCmd: 'reverse tcp:' + PORT + ' tcp:' + PORT,
          proxySet: 'shell settings put global http_proxy 127.0.0.1:' + PORT,
          proxyClear: 'shell settings put global http_proxy :0',
          openUrl: 'shell am start -a android.intent.action.VIEW -d "{URL}"'
        })); }
        catch (ex) { log('Android module init failed: ' + ex, 'err'); }
        try { list.push(createDeviceModule({
          name: 'HarmonyOS', tool: 'hdc', known: false,
          certDir: '/etc/security/certificates',
          pushCmd: 'file send', listCmd: 'list targets',
          devtoolsCmd: 'forward tcp:9222',
          reverseCmd: 'rport tcp:' + PORT + ' tcp:' + PORT,
          proxySet: 'shell network-cfg set http_proxy 127.0.0.1:' + PORT,
          proxyClear: 'shell network-cfg set http_proxy 0',
          openUrl: 'shell aa start -d "{URL}"'
        })); }
        catch (ex) { log('HarmonyOS module init failed: ' + ex, 'err'); }
        return list;
      })(),
      draft: '', modal: null,
      cur: null, tabs: [], rows: [], tools: [],
      dot: String.fromCharCode(9679)
    },
    computed: {
      cur: function() { return this.modules[this.tab]; },
      tabs: function() {
        var out = [], j;
        for (j = 0; j < this.modules.length; j++) {
          var m = this.modules[j];
          out.push({ key: j, label: m.name, act: this.tab === j, tone: m.health(m.data) });
        }
        return out;
      },
      rows: function() {
        var m = this.cur, out = [], j;
        for (j = 0; j < m.states.length; j++) {
          var c = m.states[j].get(m.data);
          if (!c) continue;
          c.name = m.states[j].name;
          out.push(c);
        }
        return out;
      },
      tools: function() {
        var j, out = [];
        var list = this.cur.actions;
        for (j = 0; j < list.length; j++) if (list[j].tool) out.push(list[j]);
        return out;
      }
    },
    methods: {
      dotCls: function(t) { var o = {}; o[t === 'idle' ? 'dim' : t] = true; return o; },
      switchTab: function(k) { k = Number(k); if (isNaN(k) || k === this.tab) return; this.tab = k; },
      confirm: function(title, text, okText, cb) {
        this.modal = { title: title, text: text, okText: okText, danger: true, onOk: cb };
      },
      prompt: function(title, text, def, cb) {
        var self = this;
        var saved = loadInput(title);
        this.draft = saved || def;
        this.modal = { title: title, text: text, input: true, okText: 'OK', onOk: function() { saveInput(title, self.draft); cb(self.draft); } };
      },
      askUninstall: function() {
        var self = this, m = this.cur;
        this.confirm('Confirm', 'Remove all files and reset ' + m.name + '?\n\nThis cannot be undone.', 'Uninstall', function() { m.uninstall(m.data, self); });
      },
      runAction: function(a) {
        var self = this, m = this.cur;
        var go = function() { log('>> ' + a.name, 'dim'); a.run(m.data, self); };
        if (a.danger) this.confirm('Confirm', 'Run "' + a.name + '" on ' + m.name + '?', a.name, go);
        else go();
      },
      rowAct: function(r) {
        if (!r || !r.act) return;
        var list = this.cur.actions, j;
        for (j = 0; j < list.length; j++) if (list[j].name === r.act) { this.runAction(list[j]); return; }
        log('"' + r.act + '" is not available on ' + this.cur.name + '.', 'warn');
      },
      refresh: function() {
        if (this.busy) return;
        var self = this, m = this.cur;
        this.busy = true;
        log('Refreshing ' + m.name + '...', 'dim');
        setTimeout(function() {
          try {
            m.probe(m.data);
            log('Probed ' + m.name + ': ' + m.health(m.data) + m.summary(m.data));
          } finally {
            self.busy = false;
          }
        }, 50);
      },
      clearLog: function() { logClear(); },
      modalOk: function() { var m = this.modal; this.modal = null; if (m && m.onOk) m.onOk.call(this); },
      modalNo: function() { this.modal = null; }
    },
    mounted: function() {
      var self = this;
      win.onerror = function(msg, url, line) { log('window error: ' + msg + ' @' + (line || '?'), 'err'); return false; };
      var keyfn = function(e) {
        e = e || win.event;
        var c = e.keyCode || e.which || e.charCode;
        if (self.modal) { if (c === 27) self.modalNo(); return; }
        var tag = ((e.target && e.target.tagName) || '').toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (c === 116 || (c === 82 && (e.ctrlKey || e.metaKey))) {
          if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
          self.refresh();
        }
      };
      if (doc.addEventListener) doc.addEventListener('keydown', keyfn, false);
      else doc.attachEvent('onkeydown', keyfn);
      log(hasShell ? 'mshta host - workdir: ' + WORKDIR + '. Click Refresh to probe modules.' : 'Browser host - no shell, actions will fail here.');
    }
  });

})(window, document);
</script>
</body>
</html>